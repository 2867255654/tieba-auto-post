# 目标贴吧（热门游戏吧，逗号分隔，可填多个游戏吧一起发）
# 示例：FORUM_NAMES=抗压背锅吧,英雄联盟吧,原神吧,王者荣耀吧
FORUM_NAMES=抗压背锅吧

# 发帖开关：默认 0 = 草稿预览，绝不自动发帖；改为 1 才会真发（需填 BDUSS）
POST_MODE=0

# 贴吧登录态 BDUSS（从浏览器 F12 → 任意请求 Cookie 里复制 BDUSS= 字段，只复制该字段）
# 仅在 POST_MODE=1 时需要。注意：BDUSS 等同账号钥匙，勿泄露、勿提交到仓库。
BDUSS=

# 贴吧登录态 STOKEN（和 BDUSS 在同一 Cookie 列表里；部分账号发帖接口必须同时携带 BDUSS + STOKEN）
# 如果只有 BDUSS 时发帖报 TooManyRedirects / 反复重定向，把这个也填上。
STOKEN=

# 百度新版登录态补充 Cookie BDUSS_BFESS（和 BDUSS 在同一 Cookie 列表里）
# 截图里没有 STOKEN 时，通常有这个；把它也填上可解决大部分 TooManyRedirects。
# 如果浏览器 Cookie 列表里没有这个字段，留空，不要复制 BDUSS 的值。
BDUSS_BFESS=

# 百度通用设备/会话 Cookie BAIDUID（和 BDUSS 在同一 Cookie 列表里）
# 如果 get_fid 报"无法获取 fid"，把这个也填上。值通常以 C 或 B 开头，中间带 : 号。
# 若浏览器里只有 BAIDUID_BFESS 没有 BAIDUID，填到下面 BAIDUID_BFESS= 里，效果相同。
BAIDUID=
BAIDUID_BFESS=

# 每天摘抄条数 / 资讯时间窗口（小时）
TOP_N=8
MAX_AGE_HOURS=24

# LLM（OpenAI 兼容接口）。国内可用 DeepSeek 等：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# 不填 LLM_API_KEY 则使用内置兜底摘要（无 AI 润色，但带来源标注）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# RSSHub 实例地址（逗号分隔可填多个，自建实例务必放第一位，其后跟公开兜底）。
# 国内游戏站（3DM/游民/小黑盒/A9VG/indienova）走这些实例的路由。
# 强烈建议自建 RSSHub（Docker 一行起）并填到首位；公开实例 https://rsshub.app 常超时。
# 示例：RSSHUB_BASE=https://你的rsshub域名,https://rsshub.app
RSSHUB_BASE=https://rsshub.app

# 发帖前随机延迟上限（秒），降低风控命中
DELAY_SECONDS=3
