# 目标贴吧（热门游戏吧，逗号分隔，可填多个游戏吧一起发）
# 示例：FORUM_NAMES=抗压背锅吧,英雄联盟吧,原神吧,王者荣耀吧
FORUM_NAMES=抗压背锅吧

# 发帖开关：默认 0 = 草稿预览，绝不自动发帖；改为 1 才会真发（需填 BDUSS）
POST_MODE=0

# ===== 浏览器发帖（默认方式）=====
# 贴吧 PC 端发帖接口已改到 /c/c/thread/add，强制校验浏览器行为签名（sign/jt），
# 纯 requests 发帖会被判定为机器人并返回 no=2000。本程序默认改用真实 Chrome
# 打开贴吧页面完成发帖（和你手动点「发贴」完全一样），从根上绕开风控。
BROWSER_MODE=1
# 有头/无头。默认 0 = 有头（会弹出 Chrome 窗口，更接近真人，成功率更高）。
# 调试或服务器环境可设 1；注：百度对无头浏览器有检测，无头更容易被拦。
BROWSER_HEADLESS=0
# 浏览器通道：chrome（用系统已装的 Chrome）/ msedge / 留空（用 Playwright 自带 chromium）
# 用系统 Chrome 无需额外下载内核，推荐保留 chrome。
BROWSER_CHANNEL=chrome

# 推荐：从浏览器 F12 整串复制的完整 Cookie（含 BDUSS / STOKEN / BAIDUID 等，最可靠）
# 获取方式：浏览器登录贴吧 → F12 → Network → 刷新页面 → 点任意请求 → Request Headers
#           → 复制 Cookie: 后面那一整串，粘贴到下面等号后面（一行，别换行）。
# 注意：Cookie 等同账号钥匙，勿泄露、勿提交到仓库（本文件已被 .gitignore 排除）。
COOKIE_STRING=

# ---- 以下单字段 Cookie 为备选（COOKIE_STRING 为空时使用）----
# 贴吧登录态 BDUSS（从浏览器 F12 → 任意请求 Cookie 里复制 BDUSS= 字段，只复制该字段）
# 仅在 POST_MODE=1 时需要。注意：BDUSS 等同账号钥匙，勿泄露、勿提交到仓库。
# ⚠️ BDUSS 会失效（贴吧服务器会主动清除过期/被顶的登录态）。失效后所有发帖都会失败，
#    表现为日志里「登录态：❌ 无效」或发帖返回 no=2000。此时需重新复制最新 Cookie。
BDUSS=

# 贴吧登录态 STOKEN（和 BDUSS 在同一 Cookie 列表里；部分账号发帖接口必须同时携带 BDUSS + STOKEN）
# 如果只有 BDUSS 时发帖报 TooManyRedirects / 反复重定向，把这个也填上。
STOKEN=

# 百度新版登录态补充 Cookie BDUSS_BFESS（和 BDUSS 在同一 Cookie 列表里）
# 截图里没有 STOKEN 时，通常有这个；把它也填上可解决大部分 TooManyRedirects。
# 如果浏览器 Cookie 列表里没有这个字段，留空，不要复制 BDUSS 的值。
BDUSS_BFESS=

# 百度通用设备/会话 Cookie BAIDUID（和 BDUSS 在同一 Cookie 列表里）
# 如果 get_fid 报"无法获取 fid"，把这个也填上。值通常以 C 或 B 开头，中间带 : 号。
# 若浏览器里只有 BAIDUID_BFESS 没有 BAIDUID，填到下面 BAIDUID_BFESS= 里，效果相同。
BAIDUID=
BAIDUID_BFESS=

# 百度移动端/wise 站点 Cookie BAIDU_WISE_UID（和 BDUSS 在同一 Cookie 列表里）
# 部分移动端接口（/mo/q/fid）高热度吧返回雷达页时，加上这个可能拿到真实 fid。
BAIDU_WISE_UID=

# 手动 fid 映射（JSON 格式）。当自动取 fid 都被某个吧的风控拦截时，
# 可在浏览器打开该吧，F12 查看页面源码搜索 "forum_id"，把数字填到这里。
# 示例：FORUM_FID_MAP={"epic吧":"123456","Steam吧":"654321"}
FORUM_FID_MAP={}

# 每天摘抄条数 / 资讯时间窗口（小时）
TOP_N=8
MAX_AGE_HOURS=24

# LLM（OpenAI 兼容接口）。三种用法任选其一：
# ① 首选 智谱 GLM（国内手机号注册）。默认 glm-4-flash（免费；但容易幻觉、长文质量一般、格式不太听话）；
#    想提升文案质量可换 glm-4-air（约 0.5 元/百万 token，每天约 0.001 元）。
#    - 去 open.bigmodel.cn 注册 → 控制台创建 API Key → 填到下面的 LLM_API_KEY。
#    LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#    LLM_MODEL=glm-4-flash    # 质量优先可选：glm-4-air
# ② 备选（改这两行 + 对应平台的 key 即可）：
#    - DeepSeek（几分钱/天，最稳）：LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
#    - Groq（免费层、快）：        LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
# ③ 留空 LLM_API_KEY = 使用内置兜底摘要（无 AI 润色，但带来源标注，抗吧梗式外壳仍在）
# 注：GitHub Models 免费端点（models.github.ai）2026-10 实测已不可用（只返回纯文本 OK），不再作为默认。
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash

# RSSHub 实例地址（逗号分隔可填多个，自建实例务必放第一位，其后跟公开兜底）。
# 国内游戏站（3DM/游民/小黑盒/A9VG/indienova）走这些实例的路由。
# 强烈建议自建 RSSHub（Docker 一行起）并填到首位；公开实例 https://rsshub.app 常超时。
# 示例：RSSHUB_BASE=https://你的rsshub域名,https://rsshub.app
RSSHUB_BASE=https://rsshub.app

# 发帖前随机延迟上限（秒），降低风控命中
DELAY_SECONDS=3
