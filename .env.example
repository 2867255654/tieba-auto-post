# 目标贴吧（热门游戏吧，如 抗压背锅吧）
FORUM_NAME=抗压背锅吧

# 发帖开关：默认 0 = 草稿预览，绝不自动发帖；改为 1 才会真发（需填 BDUSS）
POST_MODE=0

# 贴吧登录态 BDUSS（从浏览器 F12 → 任意请求 Cookie 里复制 BDUSS= 字段，只复制该字段）
# 仅在 POST_MODE=1 时需要。注意：BDUSS 等同账号钥匙，勿泄露、勿提交到仓库。
BDUSS=

# 每天摘抄条数 / 资讯时间窗口（小时）
TOP_N=8
MAX_AGE_HOURS=24

# LLM（OpenAI 兼容接口）。国内可用 DeepSeek 等：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# 不填 LLM_API_KEY 则使用内置兜底摘要（无 AI 润色，但带来源标注）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# RSSHub 实例（公开实例 https://rsshub.app 不稳定，建议自建或留默认）
RSSHUB_BASE=https://rsshub.app

# 发帖前随机延迟上限（秒），降低风控命中
DELAY_SECONDS=3
